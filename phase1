[org 0x0100]

jmp start

start:
    ; Set video mode to 80x25 text mode
    mov ah, 0
    mov al, 3
    int 10h
    
    ; Hide blinking cursor
    mov ah, 1
    mov ch, 32          ; bit 5 set = hide cursor
    int 10h
    
    ; Draw the game screen
    call draw_footpath
    call draw_road
    call draw_lane_dividers
    call draw_player_car
    call draw_obstacle_car
    
    ; Wait for key press
    mov ah, 0
    int 16h
    
    ; Show cursor again
    mov ah, 1
    mov ch, 6
    mov cl, 7
    int 10h
    
    ; Return to text mode and exit
    mov ah, 0
    mov al, 3
    int 10h
    
    mov ax, 0x4c00
    int 21h

;===========================================
; Draw footpath with black and white strips on sides
;===========================================
draw_footpath:
    push ax
    push bx
    push cx
    push dx
    
    mov dh, 0           ; starting row
    
footpath_loop:
    ; Left footpath - alternating pattern
    mov dl, 0           ; starting column
    mov bh, 0
    mov ah, 2
    int 10h
    
    ; Determine pattern based on row
    mov al, dh
    and al, 1           ; check if row is odd or even
    jz left_white
    
left_black:
    mov ah, 9
    mov al, 176         ; light shade character
    mov bl, 07h         ; white on black
    mov cx, 8           ; 8 columns wide
    int 10h
    jmp right_footpath
    
left_white:
    mov ah, 9
    mov al, 177         ; medium shade
    mov bl, 70h         ; black on white
    mov cx, 8
    int 10h
    
right_footpath:
    ; Right footpath - alternating pattern
    mov dl, 72          ; starting at column 72
    mov ah, 2
    int 10h
    
    mov al, dh
    and al, 1
    jz right_white
    
right_black:
    mov ah, 9
    mov al, 176
    mov bl, 07h
    mov cx, 8
    int 10h
    jmp footpath_next
    
right_white:
    mov ah, 9
    mov al, 177
    mov bl, 70h
    mov cx, 8
    int 10h
    
footpath_next:
    inc dh
    cmp dh, 25
    jl footpath_loop
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret

;===========================================
; Draw light gray road in the middle
;===========================================
draw_road:
    push ax
    push bx
    push cx
    push dx
    
    mov dh, 0           ; starting row
    
road_loop:
    mov dl, 8           ; starting column (after footpath)
    mov bh, 0
    mov ah, 2
    int 10h
    
    ; Print space with light gray background for road
    mov ah, 9
    mov al, 176         ; light shade block
    mov bl, 77h         ; gray on gray (light gray)
    mov cx, 64          ; road width
    int 10h
    
    inc dh
    cmp dh, 25
    jl road_loop
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret

;===========================================
; Draw white lane dividers (4 narrower lanes)
;===========================================
draw_lane_dividers:
    push ax
    push bx
    push cx
    push dx
    
    ; Road is from column 8 to 71 (64 columns wide)
    ; 4 lanes = 3 dividers
    ; Lane width = 64/4 = 16 columns each
    
    ; Divider 1: column 24 (8 + 16)
    ; Divider 2: column 40 (8 + 32)
    ; Divider 3: column 56 (8 + 48)
    
    mov dh, 1           ; starting row
    
divider_loop:
    ; Divider 1
    mov dl, 24
    mov bh, 0
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 219         ; solid block
    mov bl, 0Fh         ; bright white
    mov cx, 1
    int 10h
    
    ; Divider 2
    mov dl, 40
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 219
    mov bl, 0Fh
    mov cx, 1
    int 10h
    
    ; Divider 3
    mov dl, 56
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 219
    mov bl, 0Fh
    mov cx, 1
    int 10h
    
    add dh, 3           ; spacing for dashed effect
    cmp dh, 24
    jl divider_loop
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret

;===========================================
; Draw prettier player car (red) at bottom
;===========================================
draw_player_car:
    push ax
    push bx
    push cx
    push dx
    
    ; Player car in lane 2, near bottom
    mov dh, 20          ; row 20
    mov dl, 32          ; column (centered in lane 2)
    
    ; Car top (roof)
    mov bh, 0
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 220         ; upper half block
    mov bl, 0C0h        ; red on black
    mov cx, 5           ; car width
    int 10h
    
    ; Car upper body
    inc dh
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 219         ; full block
    mov bl, 0CEh        ; red on yellow (windows)
    mov cx, 5
    int 10h
    
    ; Car lower body
    inc dh
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 219
    mov bl, 0C0h        ; red
    mov cx, 5
    int 10h
    
    ; Car bottom (with wheels)
    inc dh
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 223         ; lower half block
    mov bl, 0C0h        ; red
    mov cx, 5
    int 10h
    
    ; Draw wheels (black)
    mov dl, 33
    mov ah, 2
    int 10h
    mov ah, 0Ah
    mov al, 254         ; small square (wheel)
    mov bl, 00h
    mov cx, 1
    int 10h
    
    mov dl, 36
    mov ah, 2
    int 10h
    mov ah, 0Ah
    mov al, 254
    mov bl, 00h
    mov cx, 1
    int 10h
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret

;===========================================
; Draw prettier obstacle car (blue) at random position
;===========================================
draw_obstacle_car:
    push ax
    push bx
    push cx
    push dx
    
    ; Get random position using system time
    mov ah, 2Ch         ; get system time
    int 21h             ; CH=hour, CL=minute, DH=second, DL=hundredths
    
    ; Use DL (hundredths) for lane randomness
    mov al, dl
    mov bl, 4           ; 4 lanes
    xor ah, ah
    div bl              ; AL = quotient, AH = remainder (0-3)
    
    ; Calculate obstacle car column based on lane (AH = 0-3)
    mov al, ah          ; lane number in AL
    mov bl, 16          ; lane width
    mul bl              ; AX = lane * 16
    add ax, 8           ; add left offset
    add ax, 5           ; center in lane
    push ax             ; save column on stack
    
    ; Random row (upper half of screen)
    mov ah, 2Ch
    int 21h
    mov al, dh          ; use seconds
    mov bl, 8
    xor ah, ah
    div bl
    add ah, 3           ; row 3-10
    mov dh, ah
    pop ax              ; restore column
    mov dl, al          ; put column in DL
    
    ; Draw obstacle car (blue) - prettier design
    ; Car top (roof)
    mov bh, 0
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 220         ; upper half block
    mov bl, 01h         ; blue
    mov cx, 5
    int 10h
    
    ; Car upper body
    inc dh
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 219         ; full block
    mov bl, 19h         ; blue on light blue (windows)
    mov cx, 5
    int 10h
    
    ; Car lower body
    inc dh
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 219
    mov bl, 01h         ; blue
    mov cx, 5
    int 10h
    
    ; Car bottom
    inc dh
    mov ah, 2
    int 10h
    
    mov ah, 9
    mov al, 223         ; lower half block
    mov bl, 01h
    mov cx, 5
    int 10h
    
    ; Draw wheels (save DL first)
    mov cl, dl          ; save starting column in CL
    mov dl, cl
    inc dl
    mov ah, 2
    int 10h
    mov ah, 0Ah
    mov al, 254
    mov bl, 00h
    mov bx, 0001h
    int 10h
    
    mov dl, cl
    add dl, 4
    mov ah, 2
    int 10h
    mov ah, 0Ah
    mov al, 254
    mov bl, 00h
    mov bx, 0001h
    int 10h
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret
